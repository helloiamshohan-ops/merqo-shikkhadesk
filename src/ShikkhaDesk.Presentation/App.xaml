<Application x:Class="ShikkhaDesk.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Brand palette (docs/BRAND-GUIDELINES.md) -->
        <Color x:Key="Navy">#102A43</Color>
        <Color x:Key="Navy2">#243B53</Color>
        <Color x:Key="Teal">#25C2A0</Color>
        <Color x:Key="Bg">#F5F7FA</Color>
        <Color x:Key="Ink">#172B4D</Color>
        <Color x:Key="Muted">#627D98</Color>
        <Color x:Key="Border">#D9E2EC</Color>
        <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource Navy}" />
        <SolidColorBrush x:Key="TealBrush" Color="{StaticResource Teal}" />
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}" />
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    </Application.Resources>
</Application>
