<Window x:Class="ShikkhaDesk.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MERQO ShikkhaDesk" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        FontFamily="Noto Sans Bengali, Segoe UI" Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left sidebar -->
        <Border Grid.Column="0" Background="{StaticResource NavyBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,16,18">
                    <TextBlock Text="ShikkhaDesk" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="  MERQO" Foreground="{StaticResource TealBrush}" FontSize="13" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                </StackPanel>
                <ItemsControl DockPanel.Dock="Top" Margin="8,0">
                    <TextBlock Text="প্রধান পাতা" Foreground="White" Margin="12,8" />
                    <TextBlock Text="শিক্ষার্থী" Foreground="#D9E2EC" Margin="12,8" />
                    <TextBlock Text="ভর্তি" Foreground="#D9E2EC" Margin="12,8" />
                    <TextBlock Text="উপস্থিতি" Foreground="#D9E2EC" Margin="12,8" />
                    <TextBlock Text="পরীক্ষা ও ফলাফল" Foreground="#D9E2EC" Margin="12,8" />
                    <TextBlock Text="ফি" Foreground="#D9E2EC" Margin="12,8" />
                    <TextBlock Text="হিসাব" Foreground="#D9E2EC" Margin="12,8" />
                    <TextBlock Text="বেতন" Foreground="#D9E2EC" Margin="12,8" />
                    <TextBlock Text="রিপোর্ট" Foreground="#D9E2EC" Margin="12,8" />
                    <TextBlock Text="ব্যবস্থাপনা" Foreground="#D9E2EC" Margin="12,8" />
                </ItemsControl>
                <Button DockPanel.Dock="Bottom" Content="সম্পর্কে (About)" Click="OnAboutClick"
                        Margin="12" Padding="8,6" HorizontalAlignment="Stretch"
                        Background="Transparent" Foreground="{StaticResource TealBrush}" BorderThickness="0" />
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- Top bar: page title + status -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0">
                    <TextBlock Text="প্রধান পাতা" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="LicenseStatusText" Text="লাইসেন্স: সক্রিয়" Foreground="#16803C" Margin="12,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LanStatusText" Text="নেটওয়ার্ক: স্থানীয়" Foreground="{StaticResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="BackupStatusText" Text="ব্যাকআপ: —" Foreground="{StaticResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Row="1" Margin="16">
                <TextBlock Text="কোচিং সেন্টারের সব কাজ, এক সফটওয়্যারে।"
                           Foreground="{StaticResource MutedBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
            </ContentControl>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource BgBrush}">
                <DockPanel Margin="16,0">
                    <TextBlock x:Name="VersionText" Text="সংস্করণ 1.0.0 · স্কিমা 1" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
